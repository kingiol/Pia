PIA_ENV=development
PIA_MODE=local
# Required in cloud mode; local file database paths are ignored by Cloud.
PIA_POSTGRES_DSN=
PIA_CLOUD_AUTH_TOKEN=
PIA_CLOUD_USERS=
PIA_HOST=127.0.0.1
PIA_PORT=8765
PIA_DB_PATH=.pia/pia.sqlite3
PIA_FIXTURE_DIR=tests/fixtures
PIA_DETERMINISTIC_REPLAY=1
PIA_DATA_PROVIDER=akshare
PIA_PROVIDER_FALLBACK=1
PIA_PROVIDER_RETRY_ATTEMPTS=2
PIA_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
PIA_PROVIDER_RETRY_MAX_BACKOFF_SECONDS=2.0
PIA_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PIA_PROVIDER_CIRCUIT_RESET_SECONDS=30
PIA_REQUIRE_LLM=0
PIA_STRUCTURED_LOGS=0
PIA_NATIVE_NOTIFICATIONS=0
PIA_NOTIFICATION_WEBHOOK_URL=
PIA_NOTIFICATION_WEBHOOK_TOKEN=
PIA_EMAIL_SMTP_HOST=
PIA_EMAIL_SMTP_PORT=587
PIA_EMAIL_SMTP_USERNAME=
PIA_EMAIL_SMTP_PASSWORD=
PIA_EMAIL_SENDER=
PIA_EMAIL_RECIPIENT=
PIA_EMAIL_SMTP_SSL=0
PIA_EMAIL_SMTP_STARTTLS=1
PIA_DEVICE_PUSH_GATEWAY_URL=
PIA_DEVICE_PUSH_GATEWAY_TOKEN=
PIA_WEB_PUSH_GATEWAY_URL=
PIA_WEB_PUSH_GATEWAY_TOKEN=
PIA_APNS_GATEWAY_URL=
PIA_APNS_GATEWAY_TOKEN=
PIA_FCM_GATEWAY_URL=
PIA_FCM_GATEWAY_TOKEN=
VITE_WEB_PUSH_PUBLIC_KEY=
PIA_AUTO_EVENT_GENERATION=1
PIA_MARKET_BREADTH_EVENT_THRESHOLD=0.15
PIA_PRICE_VOLUME_ANOMALY_PCT=5.0
PIA_PORTFOLIO_RISK_DRAWDOWN_DELTA=0.05
PIA_PORTFOLIO_RISK_WEIGHT_DELTA=0.10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PIA_LLM_RETRY_ATTEMPTS=2
PIA_LLM_RETRY_BACKOFF_SECONDS=0.25
PIA_LLM_RETRY_MAX_BACKOFF_SECONDS=2.0
DEEPSEEK_INPUT_COST_PER_1K=0
DEEPSEEK_OUTPUT_COST_PER_1K=0
TUSHARE_TOKEN=__PROVIDE_LATER__
