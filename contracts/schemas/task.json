{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchTask",
  "type": "object",
  "required": ["id", "trigger_type", "status", "created_at"],
  "properties": {
    "id": {"type": "string"},
    "trigger_type": {"type": "string"},
    "status": {"enum": ["QUEUED", "PLANNING", "RUNNING", "REVIEWING", "PAUSED", "WAITING_APPROVAL", "APPROVED", "REJECTED", "BLOCKED", "NO_ACTION", "RETRYABLE", "FAILED", "TIMEOUT", "CANCELLED", "EXPIRED", "DONE"]},
    "target": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "data_snapshot_id": {"type": ["string", "null"]},
    "rule_snapshot_id": {"type": ["string", "null"]},
    "result_metadata": {"$ref": "result-metadata.json"}
  }
}
